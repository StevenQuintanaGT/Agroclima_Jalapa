{
  "name": "agroclima-jalapa-functions",
  "description": "Ciclo automático de AgroClima Jalapa (lo ejecuta GitHub Actions cada 3 h): clima, motor de alertas y avisos.",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "jest --testPathIgnorePatterns test-reglas test-emulador",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-agroclima-reglas \"jest test-reglas --runInBand\"",
    "test:emulador": "firebase emulators:exec --only firestore --project demo-agroclima-reglas \"jest test-reglas test-emulador --runInBand\"",
    "emuladores": "firebase emulators:start --only auth,firestore",
    "sembrar:emulador": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/sembrar-umbrales.js",
    "deploy:reglas": "firebase deploy --only firestore:rules,firestore:indexes",
    "simular:emulador": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/simular-pronostico.js"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "cross-env": "^10.1.0",
    "firebase": "^12.19.0",
    "jest": "^30.5.2"
  }
}
