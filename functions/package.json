{
  "name": "agroclima-jalapa-functions",
  "description": "Ciclo automático de AgroClima Jalapa: adquisición de clima, motor de alertas y notificaciones.",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "jest --testPathIgnorePatterns test-reglas",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-agroclima-reglas \"jest test-reglas --runInBand\"",
    "emuladores": "firebase emulators:start --only auth,firestore,functions",
    "sembrar:emulador": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/sembrar-umbrales.js",
    "deploy": "firebase deploy --only functions"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "cross-env": "^10.1.0",
    "firebase": "^12.19.0",
    "jest": "^30.5.2"
  }
}
